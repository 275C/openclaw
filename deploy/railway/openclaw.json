{
  "$schema": "https://docs.openclaw.ai/schema/openclaw.json",
  "env": {
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-v4-pro"
      }
    }
  },
  "gateway": {
    "controlUi": {
      "allowedOrigins": [
        "https://openclaw-stagingopenclaw.up.railway.app"
      ],
      "trustTokenAuth": true
    },
    "trustedProxies": [
      "100.64.0.0/10"
    ]
  }
}
